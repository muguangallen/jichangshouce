---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import { providers } from '../../data/providers';

const breadcrumbs = [{ label: '机场测评' }];
---
<BaseLayout
  title="机场测评 - 品牌资料索引与真实测评规范"
  description="机场测评与品牌资料库索引。本站严格区分服务商公开资料与本站实测，拒绝伪造延迟数据，帮助用户客观判定稳定度与避坑。"
  schemaType="CollectionPage"
>
  <div class="container section">
    <Breadcrumb items={breadcrumbs} />

    <div class="section-header">
      <h1 class="section-title">机场测评与品牌资料索引</h1>
      <p class="section-desc">
        我们坚持“无真实实测不虚构数据”的编辑伦理。这里汇总了全站 28 个服务商的品牌数据档案。
      </p>
    </div>

    <div class="editorial-note" style="margin-bottom: 2.5rem;">
      <h4>⚖️ 本站编辑测评原则</h4>
      <p>1. <strong>区分来源层级：</strong>页面明确标示哪些为“服务商公开资料”，哪些为“编辑体验”或“实测”。</p>
      <p>2. <strong>拒绝虚假速度：</strong>未经过本站长周期盲测的品牌，延迟与速度字段均显示“暂无测试数据”，绝不默认填充 99.9% 稳定度等夸大营销数字。</p>
    </div>

    <div class="grid-3">
      {providers.map((p, idx) => (
        <ProviderCard provider={p} rank={idx + 1} />
      ))}
    </div>
  </div>
</BaseLayout>
