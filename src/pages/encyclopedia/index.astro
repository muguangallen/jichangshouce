---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { terms } from '../../data/encyclopedia';

const breadcrumbs = [{ label: '网络术语词典' }];
---
<BaseLayout
  title="网络术语词典 - IPLC / IEPL / BGP / VLESS / Trojan 专有名词解析"
  description="面向普通用户的网络服务专有名词词典：包含 IPLC 专线、IEPL 专线、BGP 中转、VLESS、Trojan、Hysteria 2、节点倍率等常用技术术语的通俗解释。"
  schemaType="CollectionPage"
>
  <div class="container section">
    <Breadcrumb items={breadcrumbs} />

    <div class="section-header">
      <h1 class="section-title">网络工具与机场术语词典</h1>
      <p class="section-desc">
        先讲人话，再讲技术。通俗易懂地解释名词含义、为什么你需要了解它以及相关使用场景。
      </p>
    </div>

    <div class="terms-grid">
      {terms.map(item => (
        <div class="card term-card-item" id={item.slug} style="margin-bottom: 2rem;">
          <div class="term-header">
            <span class="badge badge-green">{item.category}</span>
            <h2 style="font-size:1.5rem;margin:0.4rem 0 0.2rem 0;border-bottom:none;padding-bottom:0;color:var(--color-primary);">
              {item.term} ({item.englishTerm})
            </h2>
            <p style="font-size:1rem;color:var(--text-muted);font-weight:600;margin-bottom:1rem;">
              一句话概括：{item.summary}
            </p>
          </div>

          <div class="term-body" style="font-size:0.95rem;line-height:1.7;">
            <p><strong>💡 简单理解：</strong>{item.plainExplanation}</p>
            <p><strong>❓ 为什么用户需要知道：</strong>{item.whyUserNeedsToKnow}</p>
          </div>

          <div class="term-footer" style="margin-top:1rem;padding-top:0.85rem;border-top:1px dashed var(--border-light);font-size:0.85rem;color:var(--text-light);">
            <span>相关参考品牌：{item.relatedProviders.join('、')}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .term-card-item {
    scroll-margin-top: 90px;
  }
</style>
