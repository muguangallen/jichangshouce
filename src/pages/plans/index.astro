---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { providers } from '../../data/providers';
import { articles } from '../../data/articles';

const planArticles = articles.filter(a => a.category === '套餐选择' || a.slug.includes('taocan') || a.slug.includes('liuliang'));
const breadcrumbs = [{ label: '套餐选择' }];
---
<BaseLayout
  title="套餐选择 - 预算决策模型：月付 vs 年付与流量精算"
  description="机场套餐选购逻辑：包含 ￥15~￥25 经济档、￥30~￥40 主力专线档、￥60+ 商业大流量档精算，以及一次性不限时流量包选购分析。"
  schemaType="CollectionPage"
>
  <div class="container section">
    <Breadcrumb items={breadcrumbs} />

    <div class="section-header">
      <h1 class="section-title">机场套餐选购与预算决策模型</h1>
      <p class="section-desc">
        不盲目追求超大流量，也不花冤枉钱。帮助你根据月预算、用网频率与设备数量精算套餐成本。
      </p>
    </div>

    <!-- Budget Tiers Breakdown -->
    <div class="grid-3" style="margin-bottom: 3rem;">
      <div class="card" style="border-top: 3px solid var(--color-green);">
        <span class="badge badge-green" style="width:fit-content;margin-bottom:0.5rem;">预算档 1</span>
        <h3 class="card-title">经济入门档 (￥15 ~ ￥25 / 月)</h3>
        <p class="card-body">
          • <strong>月流量：</strong>80GB ~ 150GB<br>
          • <strong>线路配置：</strong>普通 BGP 中转 / 公网优化<br>
          • <strong>适合场景：</strong>轻度网页检索、微信/TG 聊天、偶用 ChatGPT。<br>
          • <strong>代表品牌：</strong>梯子云、微风网络、一翻云。
        </p>
      </div>

      <div class="card" style="border-top: 3px solid var(--color-accent);">
        <span class="badge badge-amber" style="width:fit-content;margin-bottom:0.5rem;">黄金主力档 (推荐)</span>
        <h3 class="card-title">主力专线档 (￥28 ~ ￥40 / 月)</h3>
        <p class="card-body">
          • <strong>月流量：</strong>150GB ~ 350GB (1.0x 全倍率)<br>
          • <strong>线路配置：</strong>IPLC / IEPL 专线、BGP 智能中转<br>
          • <strong>适合场景：</strong>日常 4K 视频追剧、全天稳定 AI 工具、远程办公。<br>
          • <strong>代表品牌：</strong>浪网、FlyV、飞猫云、二猫云 2mao。
        </p>
      </div>

      <div class="card" style="border-top: 3px solid var(--color-primary);">
        <span class="badge" style="width:fit-content;margin-bottom:0.5rem;">高端/商业档</span>
        <h3 class="card-title">大流量与定制包 (￥60+ / 月)</h3>
        <p class="card-body">
          • <strong>月流量：</strong>500GB ~ 2TB+ / 不限设备<br>
          • <strong>线路配置：</strong>2.5Gbps 超大带宽、独立 IP 定制<br>
          • <strong>适合场景：</strong>团队共享、8K 下载重度党、TikTok 直播。<br>
          • <strong>代表品牌：</strong>EdgeNova、浪网商业包、U1S1。
        </p>
      </div>
    </div>

    <!-- Non-expiring plan analysis -->
    <div class="editorial-note" style="margin-bottom: 3rem;">
      <h4>💡 一次性不限时流量包适用分析</h4>
      <p>对于出差频繁、用网不固定的用户，购买按月扣费的套餐容易浪费流量。像 <strong>浪网</strong> 等机场提供的一次性不限时流量包（如 ￥239 元 / 180GB），流量不过期、用多少扣多少，极度适合作为随身备用防护网。</p>
    </div>

    <h2 class="section-title">套餐相关深度指南</h2>
    <div class="grid-3">
      {planArticles.map(article => (
        <div class="card">
          <span class="badge badge-amber" style="width:fit-content;margin-bottom:0.5rem;">{article.category}</span>
          <h3 class="card-title" style="font-size:1.1rem;">
            <a href={`/article/${article.slug}/`} style="color:var(--color-primary);text-decoration:none;">
              {article.title}
            </a>
          </h3>
          <p class="card-body" style="font-size:0.875rem;">
            {article.description}
          </p>
          <a href={`/article/${article.slug}/`} style="font-size:0.85rem;font-weight:600;margin-top:auto;">阅读全文 →</a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
