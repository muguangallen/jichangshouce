---
import type { Provider } from '../data/providers';
import AffiliateLink from './AffiliateLink.astro';

interface Props {
  provider: Provider;
  rank?: number;
}

const { provider, rank } = Astro.props;
---
<div class="provider-card">
  <div class="card-header">
    <div class="header-left">
      {rank && <span class="rank-badge">#{rank}</span>}
      <h3 class="provider-name">{provider.name}</h3>
    </div>
    <span class="source-tag">{provider.sourceType}</span>
  </div>

  <p class="provider-desc">{provider.description}</p>

  <div class="specs-grid">
    <div class="spec-item">
      <span class="spec-label">线路类型</span>
      <span class="spec-val">{provider.routes.join(' / ')}</span>
    </div>
    <div class="spec-item">
      <span class="spec-label">核心协议</span>
      <span class="spec-val">{provider.protocols.join(', ')}</span>
    </div>
    <div class="spec-item">
      <span class="spec-label">流量政策</span>
      <span class="spec-val">{provider.traffic}</span>
    </div>
    <div class="spec-item">
      <span class="spec-label">测试数据</span>
      <span class="spec-val muted">{provider.testDataNote}</span>
    </div>
  </div>

  {provider.coupon && (
    <div class="coupon-banner">
      🎁 优惠码：<code>{provider.coupon}</code>
    </div>
  )}

  <div class="card-actions">
    <a href={`/service/${provider.slug}/`} class="btn btn-outline btn-sm">查看独立档案</a>
    <AffiliateLink href={provider.affiliateUrl} class="btn btn-primary btn-sm">
      访问公开入口 ↗
    </AffiliateLink>
  </div>
</div>

<style>
  .provider-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    transition: all 0.15s ease;
  }
  .provider-card:hover {
    border-color: var(--border-medium);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .rank-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-accent);
    background-color: var(--bg-surface-alt);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--border-light);
  }
  .provider-name {
    font-size: 1.25rem;
    margin: 0;
    color: var(--color-primary);
  }
  .source-tag {
    font-size: 0.725rem;
    color: var(--text-light);
    background-color: var(--bg-surface-alt);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .provider-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    background-color: var(--bg-page);
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
  }
  .spec-item {
    display: flex;
    flex-direction: column;
  }
  .spec-label {
    font-size: 0.75rem;
    color: var(--text-light);
  }
  .spec-val {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .spec-val.muted {
    font-size: 0.775rem;
    font-weight: normal;
    color: var(--text-light);
  }
  .coupon-banner {
    background-color: var(--color-amber-light);
    color: var(--color-amber);
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
  }
  .coupon-banner code {
    font-family: var(--font-mono);
    background-color: rgba(0,0,0,0.06);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }
  .card-actions {
    margin-top: auto;
    display: flex;
    gap: 0.75rem;
  }
  .btn-sm {
    font-size: 0.85rem;
    padding: 0.5rem 0.85rem;
    flex: 1;
    text-align: center;
  }
</style>
